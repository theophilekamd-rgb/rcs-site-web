# ============================================================
# Configurazione email — modulo contatti/registrazione RCS S.r.l.
# Copia questo file in ".env" (stessa cartella) e inserisci le
# credenziali reali. Il file ".env" non va mai committato in git
# (è già escluso dal .gitignore del progetto).
# ============================================================

# Porta su cui gira il server (sito + API)
PORT=4000

# --- Impostazioni SMTP ---
# Il server usa Nodemailer con un trasporto SMTP generico: funziona
# con qualsiasi provider (Google Workspace, Aruba, Register.it, ecc.).
#
# Esempio Gmail / Google Workspace:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=tuonome@gmail.com
#   SMTP_PASS=password-per-le-app  <- NON la password normale.
#     Va generata su https://myaccount.google.com/apppasswords
#     (richiede la verifica in due passaggi attiva).
#
# Esempio Aruba (frequente per domini .eu/.it italiani come rcsworld.eu):
#   SMTP_HOST=smtps.aruba.it
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=info@rcsworld.eu
#   SMTP_PASS=la-password-della-casella-di-posta
#
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Indirizzo che riceve le richieste inviate dal modulo del sito
MAIL_TO=info@rcsworld.eu

# Mittente mostrato nelle email inviate dal sito.
# Con molti provider deve coincidere (o essere sullo stesso dominio) con SMTP_USER.
MAIL_FROM="Sito RCS S.r.l. <info@rcsworld.eu>"
